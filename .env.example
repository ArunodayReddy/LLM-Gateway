# Upstream provider (any OpenAI-compatible endpoint)
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=sk-your-provider-key-here

# Gateway keys clients present as `Authorization: Bearer <key>` (comma-separated)
GATEWAY_API_KEYS=gw-dev-key-1,gw-dev-key-2

# Port the gateway listens on
PORT=8787
