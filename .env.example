# Upstream provider (any OpenAI-compatible endpoint). Used when PROVIDERS is unset.
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=sk-your-provider-key-here

# Multi-provider failover (M5): ordered JSON list, tried in order.
# PROVIDERS=[{"name":"primary","baseUrl":"https://api.openai.com/v1","apiKey":"sk-..."},{"name":"fallback","baseUrl":"https://openrouter.ai/api/v1","apiKey":"sk-..."}]

# Per-provider timeout before failover (ms)
# UPSTREAM_TIMEOUT_MS=30000

# Gateway keys clients present as `Authorization: Bearer <key>` (comma-separated)
GATEWAY_API_KEYS=gw-dev-key-1,gw-dev-key-2

# SQLite request-log store
# DB_PATH=./data/gateway.db

# Response cache: set for Redis backend, unset for in-memory
# REDIS_URL=redis://localhost:6379
# CACHE_TTL_SECONDS=3600

# Safety: comma-separated prompt substrings that get a 400
# BLOCKED_PATTERNS=

# Budgets: per-key calendar-month spend cap in USD (402 when exceeded)
# PER_KEY_MONTHLY_CAP_USD=50

# Rate limiting (M6): fixed-window per-key request caps (429 when exceeded).
# Burst is a flat grace allowance on top of the per-minute limit.
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# RATE_LIMIT_BURST=10
# RATE_LIMIT_WINDOW_SECONDS=60

# Port the gateway listens on
PORT=8787
